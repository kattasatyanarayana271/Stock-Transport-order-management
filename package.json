{
  "name": "stock-transport-management",
  "version": "1.0.0",
  "description": "Stock Transport Order (STO) Management - SAP CAP Node.js, HANA Cloud, XSUAA, Fiori Elements",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@sap/cds": "^8",
    "@cap-js/hana": "^1",
    "@sap/xssec": "^4",
    "express": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^8",
    "jest": "^29"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch --open stos/webapp/index.html",
    "test": "jest",
    "build": "cds build --production",
    "mta": "mbt build"
  },
  "jest": {
    "testTimeout": 30000,
    "testMatch": [
      "**/test/**/*.test.cjs"
    ]
  },
  "cds": {
    "requires": {
      "auth": {
        "kind": "mocked",
        "users": {
          "rahul": {
            "password": "rahul",
            "roles": [
              "STOUser"
            ]
          },
          "priya": {
            "password": "priya",
            "roles": [
              "STOUser"
            ]
          },
          "anita": {
            "password": "anita",
            "roles": [
              "STOApprover"
            ]
          },
          "vikram": {
            "password": "vikram",
            "roles": [
              "STOApprover",
              "STOSeniorApprover"
            ]
          },
          "admin": {
            "password": "admin",
            "roles": [
              "STOAdmin"
            ]
          }
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": "hana"
      }
    }
  }
}